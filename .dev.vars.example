# Neon (pooled URL for the app, direct URL for migrations)
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Neon Auth (Managed Better Auth)
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=generate-with-openssl-rand-base64-32

# Cloudflare R2 (S3 API token scoped to the audio bucket, used for presigned uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tagalog-speech-audio
AUDIO_PUBLIC_BASE_URL=https://audio.tiniglabs.digital

# Modal wav2vec2 phoneme endpoint
MODAL_ENDPOINT_URL=
MODAL_TOKEN=
CRON_SECRET=generate-a-long-random-string
